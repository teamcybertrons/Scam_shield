# ScamShield Full-Stack Environment Configuration

# Database Configuration (PostgreSQL in production, SQLite fallback in development)
DATABASE_URL=sqlite+aiosqlite:///./scamshield.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/scamshield

# AI Provider ("hybrid", "gemini", "openai", "local")
AI_PROVIDER=hybrid
GEMINI_API_KEY=
OPENAI_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=scamshield_mock_wa_token
WHATSAPP_VERIFY_TOKEN=scamshield_verify_token_2025
WHATSAPP_PHONE_NUMBER_ID=100234567890123

# Authentication & Supabase
JWT_SECRET_KEY=scamshield-super-secret-key-32-chars-long!
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Honeypot Secret
HONEYPOT_INGEST_SECRET=scamshield_honey_secret_99
